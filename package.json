{
  "name": "rent-tracker-system",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:preview": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/start-preview-ui.ps1",
    "dev:local": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/start-local-ui.ps1",
    "setup:local": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/setup-local-owner.ps1",
    "test:browser": "playwright test",
    "test:offline": "node scripts/run-offline-browser-checks.mjs",
    "test:perf": "npm run build && node scripts/check-performance.mjs",
    "test:csp": "npm run build && node scripts/check-production-csp.mjs",
    "build": "tsc --noEmit && vite build",
    "build:staging": "tsc --noEmit && vite build --mode staging",
    "preview": "vite preview --host 127.0.0.1",
    "tunnel": "ngrok http 127.0.0.1:5173",
    "test": "node --test tests/*.test.ts",
    "verify:release": "npm test && npm run build && node scripts/check-production-build.mjs",
    "test:supabase": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/test-supabase-api.ps1",
    "test:cash:supabase": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/test-cash-supabase.ps1",
    "dev:hosted": "node scripts/start-hosted-ui.mjs",
    "check:hosted": "node scripts/check-hosted-development.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "~4.3.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "~6.1.2",
    "axe-core": "4.13.0",
    "supabase": "^2.121.0",
    "tailwindcss": "~4.3.3",
    "typescript": "~5.9.3",
    "vite": "~8.3.4"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}

# Prefer npm.cmd run dev:local: it supplies these public values in memory.
# Hosted development uses npm.cmd run dev:hosted and separate ignored JSON
# .env.hosted-development.local: {"url":"https://vyzexanzktskvjxjpphp.supabase.co","key":"YOUR_PUBLISHABLE_KEY"}
# The hosted launcher checks disabled signup. Hosted production builds are refused.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=YOUR_LOCAL_PUBLIC_ANON_KEY
# Never put service-role keys or database passwords here.
